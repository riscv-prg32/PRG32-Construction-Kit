diff --git a/tests/test_shared_identity.py b/tests/test_shared_identity.py
new file mode 100644
index 0000000..8e5a05d
--- /dev/null
+++ b/tests/test_shared_identity.py
@@ -0,0 +1,192 @@
+"""The account identity shared with a PRG32-Construction-Kit (SSO contract).
+
+- The account username is the sign-in name both services share. /api/me returns it to its
+  owner, with the public handle beside it.
+- The public handle is the only name other people see (catalog, scores, multiplayer). It is
+  pseudonymous and never the username or the email.
+- An account that arrives over SSO keeps the kit's username; if that username is already
+  taken by another Store account, the accounts are not joined.
+- Accounts are matched by email over SSO, never by username or handle.
+"""
+
+from __future__ import annotations
+
+from cartridge_store import create_app, sso
+from cartridge_store.auth import init_auth_db, load_user
+from cartridge_store.database import get_db
+from cartridge_store import sso_protocol as protocol
+
+SECRET = "a-shared-classroom-secret-that-is-long-enough"
+PASSWORD = "student-password-1"
+
+
+def make_store(path, **extra):
+    app = create_app({"TESTING": True, "DATA_DIR": str(path), "SSO_SECRET": SECRET,
+                      "SSO_PEER_URL": "http://kit.test", **extra})
+    app.test_client().get("/")          # the first request makes the tables
+    return app
+
+
+def kit_record(username, email, **extra):
+    from werkzeug.security import generate_password_hash
+
+    return {"username": username, "email": email, "role": "user", "groups": [],
+            "password_hash": generate_password_hash(PASSWORD), "updated_at": protocol.timestamp_now(), **extra}
+
+
+def import_from_kit(app, record):
+    with app.app_context():
+        return sso.apply_record(record)
+
+
+def row(app, email):
+    with app.app_context():
+        return dict(get_db().execute("SELECT * FROM users WHERE email = ?", (email,)).fetchone())
+
+
+def sign_in(app, login):
+    client = app.test_client()
+    assert client.post("/auth/login", data={"username": login, "password": PASSWORD}).status_code == 302
+    return client
+
+
+def test_me_returns_the_account_username_and_a_separate_public_handle(tmp_path):
+    app = make_store(tmp_path)
+    assert import_from_kit(app, kit_record("ada", "ada@school.test")) == "created"
+    me = sign_in(app, "ada@school.test").get("/api/me").get_json()["user"]
+    assert me["username"] == "ada"
+    assert me["public_handle"].startswith("player-") and me["name"] == me["public_handle"]
+    assert "ada" not in me["public_handle"] and "@" not in me["public_handle"]
+
+
+def test_sso_ticket_sign_in_gives_the_same_username(tmp_path):
+    app = make_store(tmp_path)
+    import_from_kit(app, kit_record("ada", "ada@school.test"))
+    ticket = protocol.make_ticket(SECRET, email="ada@school.test", audience="cartridge-store", purpose="login", ttl=60)
+    browser = app.test_client()
+    assert browser.post("/auth/sso/accept", data={"ticket": ticket}).status_code == 302
+    assert browser.get("/api/me").get_json()["user"]["username"] == "ada"
+
+
+def test_other_people_only_see_the_public_handle(tmp_path):
+    app = make_store(tmp_path)
+    import_from_kit(app, kit_record("ada", "ada@school.test"))
+    ada = sign_in(app, "ada@school.test")
+    handle = ada.get("/api/me").get_json()["user"]["public_handle"]
+    assert ada.post("/api/scores", json={"game": "pong", "player": "A", "score": 3}).status_code == 200
+    public = app.test_client().get("/api/scores").get_data(as_text=True)
+    assert handle in public and "ada@school.test" not in public and '"ada"' not in public
+    with app.app_context():
+        seen_by_peers = load_user(int(row(app, "ada@school.test")["id"])).public_dict()
+    assert seen_by_peers == {"name": handle, "public_handle": handle, "role": "user", "authenticated": True}
+
+
+def test_a_username_taken_by_another_store_account_is_not_joined(tmp_path):
+    """Collision: a Store-only "ada" exists with another email. The kit's ada gets her own account."""
+    app = make_store(tmp_path)
+    import_from_kit(app, kit_record("ada", "ada@other-school.test"))
+    with app.app_context():
+        get_db().execute("UPDATE users SET updated_at = '2000-01-01T00:00:00Z'")   # Store-only from now on
+        get_db().commit()
+    store_ada = row(app, "ada@other-school.test")
+    assert import_from_kit(app, kit_record("ada", "ada@school.test")) == "created"
+    kit_ada = row(app, "ada@school.test")
+    assert kit_ada["id"] != store_ada["id"]
+    assert kit_ada["username"] == "ada@school.test"            # falls back to the email, never "ada"
+    assert row(app, "ada@other-school.test") == store_ada       # the other account is untouched
+    assert kit_ada["public_handle"] != store_ada["public_handle"]
+    # Each signs in to their own account.
+    assert sign_in(app, "ada@school.test").get("/api/me").get_json()["user"]["email"] == "ada@school.test"
+    assert sign_in(app, "ada@other-school.test").get("/api/me").get_json()["user"]["email"] == "ada@other-school.test"
+
+
+def test_a_rename_onto_a_taken_username_keeps_the_old_one(tmp_path):
+    app = make_store(tmp_path)
+    import_from_kit(app, kit_record("ada", "ada@school.test"))
+    import_from_kit(app, kit_record("bob", "bob@school.test"))
+    assert import_from_kit(app, kit_record("bob", "ada@school.test")) == "updated"
+    assert row(app, "ada@school.test")["username"] == "ada"
+    assert import_from_kit(app, kit_record("ada-lovelace", "ada@school.test")) == "updated"
+    assert row(app, "ada@school.test")["username"] == "ada-lovelace"
+
+
+def test_a_public_handle_never_decides_who_signs_in(tmp_path):
+    """A handle that equals another account's username does not let anyone sign in as that account."""
+    app = make_store(tmp_path)
+    import_from_kit(app, kit_record("ada", "ada@school.test"))
+    import_from_kit(app, kit_record("bob", "bob@school.test"))
+    with app.app_context():
+        get_db().execute("UPDATE users SET public_handle = 'ada' WHERE email = 'bob@school.test'")
+        get_db().commit()
+    me = sign_in(app, "ada").get("/api/me").get_json()["user"]
+    assert me["email"] == "ada@school.test" and me["username"] == "ada"
+    ticket = protocol.make_ticket(SECRET, email="bob@school.test", audience="cartridge-store", purpose="login", ttl=60)
+    browser = app.test_client()
+    browser.post("/auth/sso/accept", data={"ticket": ticket})
+    assert browser.get("/api/me").get_json()["user"]["username"] == "bob"
+
+
+def test_migrated_accounts_keep_their_username(tmp_path):
+    """Migration: rows from before public handles keep their username; only the handle is added."""
+    app = make_store(tmp_path)
+    import_from_kit(app, kit_record("cyrus", "cy@school.test"))
+    import_from_kit(app, kit_record("dee@school.test", "dee@school.test"))
+    with app.app_context():
+        db = get_db()
+        db.execute("DROP INDEX users_public_handle_idx")
+        db.execute("UPDATE users SET public_handle = NULL WHERE email IN ('cy@school.test', 'dee@school.test')")
+        db.commit()
+        init_auth_db()
+    cy, dee = row(app, "cy@school.test"), row(app, "dee@school.test")
+    assert cy["username"] == "cyrus" and cy["public_handle"] == "cyrus"
+    assert dee["username"] == "dee@school.test" and "@" not in dee["public_handle"]
+    assert sign_in(app, "cyrus").get("/api/me").get_json()["user"]["username"] == "cyrus"
+    assert sign_in(app, "dee@school.test").get("/api/me").get_json()["user"]["username"] == "dee@school.test"
+
+
+def test_the_notice_gate_answers_api_calls_in_json(tmp_path):
+    app = make_store(tmp_path)
+    import_from_kit(app, kit_record("ada", "ada@school.test"))
+    ada = sign_in(app, "ada@school.test")
+    with ada.session_transaction() as browser_session:
+        browser_session["privacy_notice_pending"] = True
+    me = ada.get("/api/me")
+    assert me.status_code == 200 and me.get_json()["privacy_notice_pending"] is True
+    assert me.get_json()["user"]["username"] == "ada"
+    refused = ada.post("/api/scores", json={"game": "pong", "player": "A", "score": 3})
+    assert refused.status_code == 403 and refused.get_json()["code"] == "privacy_notice_required"
+    page = ada.get("/publish")
+    assert page.status_code == 302 and "/auth/privacy-acknowledge" in page.headers["Location"]
+
+
+def test_sso_sign_in_shows_the_notice_once_per_version(tmp_path):
+    app = make_store(tmp_path)
+    app.config["TESTING"] = False
+    with app.app_context():
+        sso.apply_record(kit_record("ada", "ada@school.test"))
+
+    def arrive():
+        ticket = protocol.make_ticket(SECRET, email="ada@school.test", audience="cartridge-store", purpose="login", ttl=60)
+        browser = app.test_client()
+        return browser, browser.post("/auth/sso/accept", data={"ticket": ticket, "next": "/publish"})
+
+    browser, first = arrive()
+    assert "/auth/privacy-acknowledge" in first.headers["Location"]
+    form = browser.get("/auth/privacy-acknowledge").get_data(as_text=True)
+    version = form.split('name="privacy_notice_version" value="', 1)[1].split('"', 1)[0]
+    csrf = form.split('name="csrf-token" content="', 1)[1].split('"', 1)[0]
+    assert browser.post("/auth/privacy-acknowledge", data={"privacy_notice_version": version, "csrf_token": csrf,
+                                                           "next": "/publish"}).status_code == 302
+    _browser, second = arrive()
+    assert second.headers["Location"] == "/publish"
+
+
+def test_unsigned_api_posts_get_401_not_a_csrf_error(tmp_path):
+    app = make_store(tmp_path, CSRF_ENABLED=True)
+    assert app.test_client().post("/api/publish/bundle").status_code == 401
+    browser = app.test_client()
+    browser.get("/auth/login")
+    with browser.session_transaction() as browser_session:
+        csrf = browser_session["csrf_token"]
+    browser.post("/auth/login", data={"username": "admin", "password": "password", "csrf_token": csrf})
+    assert browser.post("/api/publish/bundle").status_code == 400          # a signed-in browser still needs the token
