# PRG32-Construction-Kit settings for one classroom server.
#
# Docker Compose:  cp examples/deploy/classroom.env .env   (compose reads .env)
# Python/systemd:  set -a; . examples/deploy/classroom.env; set +a
#
# Full list: docs/setup.md. Install guide: docs/install_cartridge_build.md.

# First admin password. Leave it commented out and the first start writes a
# random one to initial_admin_password in the data folder (deleted when you
# change it on "My account"). If you set it, use a long random password: the
# Docker image (PRG32_KIT_ENV=production) refuses short or well-known ones.
# PRG32_ADMIN_PASSWORD=

# Reverse proxies (nginx, Caddy, Traefik) in front of the kit: how many. Leave 0
# when browsers connect directly. Used to find the browser's address for the
# sign-in limits (docs/security.md).
# PRG32_KIT_PROXY_COUNT=1

# --- Cartridge builds -----------------------------------------------------------
# Docker only: 1 installs the RISC-V compiler and PRG32 tools into the image.
PRG32_TOOLCHAIN=1
# Docker only: PRG32 version to build with. Use a tag or commit id for a term.
PRG32_REF=main
# Docker only: the PRG32 copy and RISC-V compiler release the image uses.
# PRG32_REPO=https://github.com/riscv-prg32/PRG32.git
# RISCV_GCC_VERSION=esp-14.2.0_20241119
# 1 = stop the container when cartridge builds don't work (default in the full image).
# PRG32_REQUIRE_TOOLCHAIN=1
# Compilers that run at the same time. One per CPU core is a good start.
PRG32_MAX_PARALLEL_BUILDS=4
# Seconds a build waits for a free compiler before "server busy".
PRG32_BUILD_QUEUE_TIMEOUT=180
# Seconds one compiler run (one target) may take.
PRG32_BUILD_TIMEOUT=120
# Cartridge RAM of your PRG32 firmware profile (64 default, 32 classroom profile).
PRG32_CART_RAM_KIB=64

# --- Web server (Docker image / gunicorn) ------------------------------------------
# workers x threads should be more than the students who compile at the same moment.
PRG32_KIT_WORKERS=2
PRG32_KIT_THREADS=16
